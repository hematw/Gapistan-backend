# API
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173"
PORT="3000"
MONGO_URI="mongodb://mongo:27017/gapistan"

# JWT
JWT_SECRET="gapistanIsGreat"

# E2EE — set to false to disable encryption app-wide
E2EE_ENABLED="true"
E2EE_DEFAULT_ENABLED="true"

# LiveKit (video calls) — dev keys match livekit --dev in docker-compose
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# Email (optional — use mailhog in docker for local dev)
MY_EMAIL="someemail@example.com"
EMAIL_APP_PASS="your gmail pass key"
